{
  // Cloudflare Workers deploy config. Deploy: npm run deploy (after `npx wrangler login`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otgit-mvp",
  "main": "dist/cloudflare/index.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node scripts/build-cloudflare.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "otgit-mvp", "database_id": "59b73258-a4c1-402e-a53b-a8467bcf7264", "migrations_dir": "drizzle" }
  ],
  "observability": { "enabled": true }
}
